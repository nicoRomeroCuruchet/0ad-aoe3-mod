+constexpr uint32_t OBSERVER_FRAME_SIZE = 512;
+constexpr float OBSERVER_CAMERA_HEIGHT = 512.0f;
+constexpr float OBSERVER_NEAR_PLANE = 1.0f;
+constexpr float OBSERVER_FAR_PLANE = 1024.0f;

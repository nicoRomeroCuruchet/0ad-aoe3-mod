+std::string Interface::RenderObserverFrame(const entity_id_t entity) const
+{
+	if (!g_Game || !g_Game->IsGameStarted() || !g_GUI)
+		return {};
+
+	const Renderer::Backend::Backend backend =
+		g_VideoMode.GetBackendDevice()->GetBackend();
+	if (backend != Renderer::Backend::Backend::GL &&
+		backend != Renderer::Backend::Backend::GL_ARB)
+		return {};
+
+	CSimulation2& simulation = *g_Game->GetSimulation2();
+	CmpPtr<ICmpPosition> cmpPosition(simulation, entity);
+	CmpPtr<ICmpOwnership> cmpOwnership(simulation, entity);
+	CmpPtr<ICmpVision> cmpVision(simulation, entity);
+	if (!cmpPosition || !cmpPosition->IsInWorld() || !cmpOwnership || !cmpVision ||
+		cmpOwnership->GetOwner() != g_Game->GetPlayerID())
+		return {};
+
+	const float visionRange = cmpVision->GetRange().ToFloat();
+	if (!(visionRange > 0.0f))
+		return {};
+
+	const CFixedVector3D fixedPosition = cmpPosition->GetPosition();
+	const CVector3D focus(
+		fixedPosition.X.ToFloat(), fixedPosition.Y.ToFloat(), fixedPosition.Z.ToFloat());
+
+	CCamera observerCamera;
+	observerCamera.SetViewPort({0, 0, OBSERVER_FRAME_SIZE, OBSERVER_FRAME_SIZE});
+	observerCamera.LookAt(
+		focus + CVector3D(0.0f, OBSERVER_CAMERA_HEIGHT, 0.0f),
+		focus,
+		CVector3D(0.0f, 0.0f, -1.0f));
+	observerCamera.SetPerspectiveProjection(
+		OBSERVER_NEAR_PLANE, OBSERVER_FAR_PLANE,
+		2.0f * std::atan(visionRange / OBSERVER_CAMERA_HEIGHT));
+	observerCamera.UpdateFrustum();
+
+	CGameView* const view = g_Game->GetView();
+	CCamera* const camera = view->GetCamera();
+	const CCamera normalCamera = *camera;
+	const player_id_t normalViewedPlayer = g_Game->GetViewedPlayerID();
+	const bool normalSmoothLOS = g_RenderingOptions.GetSmoothLOS();
+	const int normalWidth = g_Renderer.GetWidth();
+	const int normalHeight = g_Renderer.GetHeight();
+	if (normalWidth < static_cast<int>(OBSERVER_FRAME_SIZE) ||
+		normalHeight < static_cast<int>(OBSERVER_FRAME_SIZE))
+		return {};
+
+	g_RenderingOptions.SetSmoothLOS(false);
+	g_Game->SetViewedPlayerID(cmpOwnership->GetOwner());
+	view->GetLOSTexture().MakeDirty();
+	g_Renderer.Resize(OBSERVER_FRAME_SIZE, OBSERVER_FRAME_SIZE);
+	*camera = observerCamera;
+	std::vector<u8> rgb(OBSERVER_FRAME_SIZE * OBSERVER_FRAME_SIZE * 3);
+	const bool rendered = g_Renderer.RenderFrameForReadback(
+		OBSERVER_FRAME_SIZE, OBSERVER_FRAME_SIZE, rgb.data());
+	*camera = normalCamera;
+	g_Renderer.Resize(normalWidth, normalHeight);
+	g_RenderingOptions.SetSmoothLOS(normalSmoothLOS);
+	g_Game->SetViewedPlayerID(normalViewedPlayer);
+	view->GetLOSTexture().MakeDirty();
+	if (rendered)
+	{
+		// Release the acquired GL backbuffer only after repainting the normal
+		// view, so the observer camera never flashes in the game window.
+		g_Renderer.RenderFrame(false);
+		g_VideoMode.GetBackendDevice()->Present();
+	}
+
+	return rendered ? MakePPM(rgb) : std::string{};
+}

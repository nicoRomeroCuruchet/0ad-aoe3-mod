+
+bool ParseObserverEntity(const char* queryString, entity_id_t& entity)
+{
+	if (!queryString)
+		return false;
+
+	char value[32]{};
+	const size_t queryLength = strlen(queryString);
+	const int length = mg_get_var(
+		queryString, queryLength, "entity", value, sizeof(value));
+	if (length <= 0 || static_cast<size_t>(length) >= sizeof(value))
+		return false;
+
+	entity_id_t parsed = INVALID_ENTITY;
+	const auto result = std::from_chars(value, value + length, parsed);
+	if (result.ec != std::errc{} || result.ptr != value + length ||
+		parsed == INVALID_ENTITY)
+		return false;
+
+	entity = parsed;
+	return true;
+}
+
+std::string MakePPM(const std::vector<u8>& bottomUpRGB)
+{
+	std::ostringstream header;
+	header << "P6\n" << OBSERVER_FRAME_SIZE << " " << OBSERVER_FRAME_SIZE << "\n255\n";
+	std::string ppm = header.str();
+	ppm.reserve(ppm.size() + bottomUpRGB.size());
+
+	const size_t rowSize = OBSERVER_FRAME_SIZE * 3;
+	for (size_t row = 0; row < OBSERVER_FRAME_SIZE; ++row)
+	{
+		const size_t sourceRow = OBSERVER_FRAME_SIZE - row - 1;
+		ppm.append(
+			reinterpret_cast<const char*>(bottomUpRGB.data() + sourceRow * rowSize),
+			rowSize);
+	}
+	return ppm;
+}

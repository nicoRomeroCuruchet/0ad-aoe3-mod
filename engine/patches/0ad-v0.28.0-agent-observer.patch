+bool CRenderer::RenderFrameForReadback(
+	const uint32_t width, const uint32_t height, void* const data)
+{
+	if (!ShouldRender() || !data || !m->device->AcquireNextBackbuffer())
+		return false;
+
+	RenderFrameImpl(false, false);
+	m->deviceCommandContext->ReadbackFramebufferSync(0, 0, width, height, data);
+	m->deviceCommandContext->Flush();
+	return true;

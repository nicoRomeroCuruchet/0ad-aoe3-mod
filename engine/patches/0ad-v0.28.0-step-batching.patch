+bool ParseTurnCount(const char* queryString, u32& turns)
+{
+	if (!queryString)
+		return false;
+
+	char value[16]{};
+	const size_t queryLength = strlen(queryString);
+	const int length = mg_get_var(
+		queryString, queryLength, "turns", value, sizeof(value));
+	if (length <= 0 || static_cast<size_t>(length) >= sizeof(value))
+		return false;
+
+	u32 parsed = 0;
+	const auto result = std::from_chars(value, value + length, parsed);
+	if (result.ec != std::errc{} || result.ptr != value + length ||
+		parsed == 0 || parsed > MAX_BATCHED_TURNS)
+		return false;
+
+	turns = parsed;
+	return true;
+}
